# Secrets — NEVER commit
infra/.env
**/.env.local
**/.env.production

# Go build artifacts
services/*/bin/
services/*/main
infra/terraform/provider/main
# Go binary named 'main' — only match files, not directories
services/**/main

# Python
**/__pycache__/
**/*.pyc
**/.venv/
**/venv/
**/*.egg-info/

# Node
**/node_modules/
**/dist/
**/.turbo/

# Java / Gradle build artifacts.
# The Gradle cache under packages/sdks/*/.gradle/ was accidentally committed and
# is untracked in this commit: its lock files re-dirty on every `gradle test`,
# which made `git status` permanently noisy and could abort a `git checkout`.
**/.gradle/
**/build/
# Compiled class output. Only ever contained generated .class files here — the
# pre-existing `services/*/bin/` rule above covers Go binaries.
**/bin/

# IDE
.idea/
.vscode/settings.json
*.code-workspace
# Eclipse/JetBrains project metadata (workspace-jetbrains/ regenerates these).
**/.project
**/.classpath
**/.settings/

# OS
.DS_Store
Thumbs.db

# Test artifacts
**/*.test
**/testdata/tmp/

# Claude Code worktrees
.claude/worktrees/

# Go workspace sum (regenerated)
go.work.sum
infra/.env.secrets

# Private scratch workspace — never commit
scratch-pad/

# Superpowers session plan files — may contain credentials/tokens
# Note: plans/ subdir is intentionally tracked (no secrets, implementation plans only)
docs/superpowers/plans/.gitignore

# TypeScript build cache
**/*.tsbuildinfo
.gstack/
