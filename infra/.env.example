# See infra/github-actions-vars.md for the complete list of GitHub Actions secrets and variables needed.
# Copy this file to infra/.env and fill in values.
# NEVER commit infra/.env to git.
#
# PRODUCTION DEPLOYMENT (Northflank + Oracle + Cloudflare Pages):
#   DB_URL        → Neon's POOLED connection string (the "-pooler" host Neon
#                    issues alongside the direct one) — used by flag-api's/
#                    intelligence's own app traffic.
#   DB_URL_DIRECT → Neon's DIRECT (non-pooled) connection string — used by
#                    cmd/migrate and anything needing session-scoped Postgres
#                    features. Never point this at the "-pooler" host.
#   REDIS_URL     → Upstash Redis TLS URL  (rediss://default:<token>@<host>.upstash.io:6379)
#   BEDROCK_*     → AWS credentials for Titan V2 embeddings (can be base64 or raw)
#   EMBEDDING_BACKEND=bedrock
#   CONSUMER_BACKEND=redis         (intelligence's Python code only recognizes
#                                    the literal "redis" -- NOT "streams", which
#                                    is gateway's own, unrelated Go-side value.
#                                    This line used to say "streams" here,
#                                    silently falling back to intelligence's
#                                    Kafka backend -- a topic with zero
#                                    producers anywhere -- found by adversarial
#                                    review of PR #210.)
#   TOMBSTONE_ENVIRONMENTS=production

# PostgreSQL
POSTGRES_USER=tombstone
POSTGRES_DB=tombstone
POSTGRES_PASSWORD=change-me

# flag-api
# DATA-2: DB_URL goes through PgBouncer (transaction pooling) — this is what
# flag-api/intelligence's own app traffic uses. cmd/migrate (and anything else
# needing session-scoped Postgres features, e.g. advisory locks pinned to one
# physical connection for a whole run) must use DB_URL_DIRECT instead, straight
# to postgres, never through the pooler. In production this same split maps
# onto Neon's own "-pooler" vs direct connection strings — no self-hosted
# PgBouncer needed there; locally, this repo's docker-compose pgbouncer
# service exists so that split can be exercised without real Neon creds.
DB_URL=postgres://tombstone:change-me@pgbouncer:5432/tombstone?sslmode=disable
DB_URL_DIRECT=postgres://tombstone:change-me@postgres:5432/tombstone?sslmode=disable
REDIS_URL=redis://redis:6379
PORT=8081
JWT_SECRET=change-me-at-least-32-chars-long

# DATA-2 — optional connection-pool tuning. Unset means the values this pool
# has always hardcoded (5/2/5min/2min), sized for Neon's free tier where the
# connection budget is shared across services. Raise these on a larger tier
# instead of editing code. Invalid/non-positive values log a warning and
# fall back to the default rather than failing startup.
DB_MAX_OPEN_CONNS=5
DB_MAX_IDLE_CONNS=2
DB_CONN_MAX_LIFETIME_SECONDS=300
DB_CONN_MAX_IDLE_TIME_SECONDS=120

# SEC-4 — REQUIRED. Service tokens and break-glass tokens are stored only as
# HMAC(pepper, token); without this, flag-api refuses to start because no service
# token could be authenticated. Must be identical across every flag-api replica,
# and changing it invalidates all existing tokens (they must be re-issued).
TOKEN_HASH_PEPPER=change-me-at-least-32-chars-long-distinct-from-jwt-secret

# SEC-4 — signs GET /api/v1/compliance/export. MUST differ from JWT_SECRET:
# whoever holds this key can verify an export, and if it were the JWT key they
# could also mint authentication tokens. Optional — when unset, flag-api still
# boots but the export endpoint returns 503 instead of signing with the JWT key.
COMPLIANCE_SIGNING_KEY=change-me-distinct-from-jwt-secret
# Emitted as "kid" in the export signature so the key can be rotated later.
COMPLIANCE_SIGNING_KEY_ID=v1

# AUD-1 — keys the audit-log hash chain. An UNKEYED chain is forgeable by anyone
# who can INSERT into audit_log, so this is what makes the chain tamper-evident.
# MUST differ from JWT_SECRET. Optional: without it flag-api still serves traffic
# but audit writes are skipped and GET /api/v1/audit/verify returns 503 rather
# than pretending to verify. Changing it invalidates verification of all entries
# written under the previous key.
AUDIT_HMAC_KEY=change-me-distinct-from-jwt-secret-and-token-pepper

# DATA-2 — how long an audit_log row stays in the live/hot table before
# POST /api/v1/audit/retention/run (admin:admin) is eligible to archive its
# whole month's partition (detach + rename, never DROP — see migration 025
# and internal/audit/retention.go). Optional: defaults to 365 days, matching
# the ~12-month observation window SOC2 Type II evidence is typically drawn
# from. This is read server-side only — no request can override it.
AUDIT_LOG_RETENTION_DAYS=365

# AUD-1b — Sigstore Rekor transparency-log submissions (optional, default
# off). Set REKOR_ENABLED=true to submit a hashedrekord entry for every
# audit-log write; REKOR_SIGNING_KEY (PEM-encoded PKCS#8 ECDSA private key,
# "\n" accepted in place of real newlines) is then REQUIRED — without it,
# flag-api still boots and serves traffic, but logs a warning at startup and
# disables submission entirely rather than sending Rekor a signature-less
# entry it would reject anyway. Unlike every other key above, this one is
# asymmetric and its public half is meant to be exposed (Rekor entries are
# publicly queryable by design). Generate one with:
#   openssl ecparam -genkey -name prime256v1 -noout | openssl pkcs8 -topk8 -nocrypt
REKOR_ENABLED=false
REKOR_SIGNING_KEY=

# SSO (optional — set SSO_PROVIDER to enable /auth/login and /auth/callback).
# SEC-5 — without SSO_ALLOWED_DOMAINS, any user your IdP successfully
# authenticates can log in, regardless of email domain; this restricts it.
# Comma-separated, "@" prefix optional (e.g. "example.com,partner.org").
SSO_PROVIDER=
OIDC_ISSUER=
OIDC_CLIENT_ID=
SSO_CALLBACK_URL=
SSO_ALLOWED_DOMAINS=

# gateway
# DB_URL not needed by gateway
# REDIS_URL and JWT_SECRET are shared above
# FLAG_API_URL is the internal Docker network address
FLAG_API_URL=http://flag-api:8081

# evaluator
# Also consumed by gateway's snapshot reconciler (services/gateway/internal/hub/reconciler.go)
# to authenticate its periodic GET /api/v1/environments/snapshot polls against flag-api.
# EVAL-4: this SAME token is now ALSO the credential evaluator's own
# POST /api/v1/rollback (manual rollback) endpoint requires as a Bearer
# token -- that endpoint previously had no authentication at all. Any
# caller triggering a manual rollback must present this exact token.
# For the auto-rollback ladder's graduated (non-full-kill) steps against
# flag-api's POST /flags/{key}/rollback-step, this token's underlying
# service_tokens row must additionally be granted role=CIRCUIT_BREAKER
# (migration 026) -- a plain OWNER/ADMIN-provisioned token can still call
# the existing binary kill switch, but gets 403 on the graduated endpoint
# by design (see services/flag-api/internal/middleware/rbac.go).
FLAG_API_TOKEN=sdk-dev-token-change-in-prod

# flag-api: base URL of services/marketplace, used to fire flag-lifecycle
# events (create/enable/disable/kill-switch/rollback/recovery/archive) at
# its webhook dispatcher, which fans out to every installed integration
# (Slack, Datadog, PagerDuty, OpsGenie, Jira, Linear, OpenTelemetry).
# Optional -- an unset value makes flag-api's notifyMarketplace a permanent
# no-op, it never blocks or fails the flag mutation it's reporting on.
MARKETPLACE_URL=http://marketplace:8086

# intelligence
PAGERDUTY_TOKEN=your-pagerduty-token-here

# Slack integration (marketplace service)
# Required for Slack slash commands and governance alerts
SLACK_BOT_TOKEN=your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
# Also consumed by evaluator (EVAL-2: services/evaluator/internal/notify)
# to post an auto-rollback alert when the circuit breaker trips. Optional
# for evaluator -- an unset value just logs a warning and skips the alert,
# it never blocks or fails the rollback itself.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your-webhook-url
# Comma-separated Slack user IDs allowed to execute kill switches (fail-closed: empty = nobody)
# Find your ID: Slack profile → ... menu → Copy member ID
SLACK_KILL_SWITCH_ALLOWED_USERS=U0123ABCD,U9876ZXYW

# evaluator: base URL of workspace-dashboard, used to build the "View in
# Dashboard" link in the Slack auto-rollback alert above (EVAL-2). Optional --
# an unset value produces a relative "/flags/{key}" link in the alert instead.
DASHBOARD_URL=http://localhost:3000

# Bedrock embeddings — swap EMBEDDING_BACKEND=bedrock to disable local BAAI/bge-m3 model
# Reuses same AWS credentials as Anvilry. Accepts raw or base64-encoded values.
EMBEDDING_BACKEND=local
BEDROCK_ACCESS_KEY_ID=change-me
BEDROCK_SECRET_ACCESS_KEY=change-me
BEDROCK_REGION=us-east-1

# Event consumer — CONSUMER_BACKEND=redis reads from
# tombstone:stream:{environment} (written by flag-api Phase 4.1) via Redis
# Streams, the same live transport gateway/evaluator already consume from.
# CONSUMER_BACKEND=kafka (the old default here) silently no-ops every
# flag-change-driven intelligence feature (embedding sync, dep-graph
# updates, flag-archival anomaly-state eviction): its two Kafka topics
# (tombstone.flag.evaluated, tombstone.flag.changed) have zero producers
# anywhere in the Go services -- found by adversarial review of PR #210.
CONSUMER_BACKEND=redis
TOMBSTONE_ENVIRONMENTS=production

# Upstash Redis REST API (for rate limiting + circuit breaker state on Go services)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=change-me

# Argos LLM rule generation (optional — graceful 503 when absent)
ANTHROPIC_API_KEY=

# dashboard
VITE_EVAL_URL=http://localhost:8082
VITE_INTEL_URL=http://localhost:8083
VITE_SDK_TOKEN=sdk-dev-token-change-in-prod

# gitops-sync (port 8084)
# No extra env vars needed beyond FLAG_API_URL and FLAG_API_TOKEN above

# ast-rewriter (port 8085)
# No extra env vars needed — stateless, no external dependencies

# marketplace (port 8086)
# DD_WEBHOOK_SECRET: HMAC-SHA256 secret used to verify inbound Datadog monitor-alert
# webhooks.  Set this to the same value configured in Datadog's Webhook Integration
# "Custom Headers" → DD-Signature.  Without this value the inbound endpoint will
# reject all requests with 401 Unauthorized.
DD_WEBHOOK_SECRET=change-me-match-datadog-webhook-secret

# EVALUATOR_URL: internal address of the evaluator service used by the inbound
# Datadog handler to look up blast-radius scores for each affected flag.
EVALUATOR_URL=http://evaluator:8082

# experiments (warehouse-native)
# WAREHOUSE_DSN is provided per-request via POST body, not as a global env var

# Edge SDK (Cloudflare Workers) — optional, enables KV snapshot sync
# CLOUDFLARE_ACCOUNT_ID=your-cf-account-id
# CLOUDFLARE_KV_NAMESPACE_ID=your-kv-namespace-id
# CLOUDFLARE_API_TOKEN=your-cf-api-token-with-kv-write-permission

# ClickHouse telemetry (optional — for 100M+ evaluations/day time-series)
# CLICKHOUSE_HOST=localhost

# mTLS — mutual TLS between internal services (optional, default off)
# Set MTLS_ENABLED=true to enable certificate-verified inter-service communication.
# flag-api generates a self-signed CA + per-service certs at startup and writes them
# to the shared certs volume. evaluator and gateway read from the same volume.
MTLS_ENABLED=false
CERTS_DIR=/certs
