{
  "name": "tombstone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.0.0",
  "engines": {
    "node": ">=18",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/sdks/@tombstone/core",
    "packages/sdks/@tombstone/react",
    "packages/sdks/@tombstone/browser",
    "packages/sdk-wasm",
    "workspace-cli",
    "workspace-dashboard",
    "workspace-mcp"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prepare": "node -e \"if (process.env.CI || process.env.VERCEL) process.exit(0)\" && husky || true"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "typescript": "~5.8.2"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "hono": "^4.13.5",
    "fast-uri": "^3.1.6",
    "ip-address": "^10.7.0",
    "js-yaml": "^4.3.2",
    "postcss": "^8.5.26",
    "brace-expansion": "^2.1.4",
    "nanoid": "^3.3.18",
    "browserslist": "^4.28.8"
  }
}
