{
  "name": "@tomb-stone/edge",
  "version": "0.1.0",
  "type": "module",
  "description": "Tombstone Edge SDK — sub-1ms flag evaluation on Cloudflare Workers via KV",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "repository": { "type": "git", "url": "git+https://github.com/sairam0424/Tombstone.git" },
  "homepage": "https://github.com/sairam0424/Tombstone",
  "bugs": { "url": "https://github.com/sairam0424/Tombstone/issues" },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && node --experimental-vm-modules node_modules/.bin/mocha 'dist/tests/*.test.js'"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.0.0",
    "mocha": "^10.0.0",
    "typescript": "~7.0.2"
  },
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "openfeature",
    "cloudflare-workers",
    "edge",
    "self-hosted",
    "devops",
    "typescript",
    "tombstone"
  ],
  "engines": { "node": ">=18" }
}
